{
  "name": "second-shift",
  "private": true,
  "type": "module",
  "workspaces": [
    "interfaces",
    "server",
    "displays"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit -p .",
    "test": "bun test",
    "setup-rcon": "bun scripts/setup-rcon.ts",
    "link-mod": "bun scripts/link-mod.ts",
    "launch": "bun scripts/launch.ts",
    "start": "bun server/src/main.ts",
    "board": "bun scripts/board.ts",
    "check": "bun test && tsc --noEmit -p . && bun scripts/board.ts --check",
    "site:dev": "bun --port=5181 website/src/index.html",
    "site:build": "bun website/build.ts",
    "site:serve": "bun website/serve.ts",
    "site:deploy": "bun website/build.ts && npx --yes wrangler@4 deploy --config website/wrangler.jsonc"
  },
  "devDependencies": {
    "@types/bun": "^1.4.2",
    "typescript": "^7.0.2"
  }
}
